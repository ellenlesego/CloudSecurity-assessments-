{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyOutsideEUWest1",
      "Effect": "Deny",
      "NotAction": [
        "iam:*",
        "organizations:*",
        "route53:*",
        "cloudfront:*",
        "globalaccelerator:*",
        "aws-portal:*",
        "budgets:*",
        "waf:*",
        "waf-regional:*",
        "shield:*",
        "sts:*"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:RequestedRegion": "eu-west-1"
        }
      }
    }
  ]
}
